    "astro": "7.3.5",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
