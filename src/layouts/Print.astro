---
import 'pretendard/dist/web/static/pretendard-dynamic-subset.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="print">
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 12mm;
  }
  body.print {
    background: var(--surface);
    font-size: 11.5px;
    line-height: 1.5;
  }
  .print main {
    max-width: 178mm;
    margin-inline: auto;
  }
  /* 쪽 나눔은 내용이 흐르는 대로 둔다. 구역 사이에 쪽을 강제로 나누면 첫 쪽 아래가 비어 4쪽을 넘기 쉽다. */
  .print h2 {
    break-after: avoid;
  }
  .print h1 {
    font-size: 22px;
    font-weight: 800;
  }
  .print .headline {
    display: block;
    font-size: 16px;
    font-weight: 700;
    margin-top: var(--sp-1);
  }
  .print h2 {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--text-3);
    margin: var(--sp-4) 0 var(--sp-2);
    padding-bottom: var(--sp-1);
    border-bottom: 1px solid var(--line);
  }
  .print .page > h2:first-child {
    margin-top: 0;
  }
  .print .kicker,
  .print .when {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-3);
  }
  .print .lead {
    color: var(--text-2);
    margin-top: var(--sp-1);
  }
  .print .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .print .grid2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-2);
  }
  .print .box {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-2) var(--sp-3);
    break-inside: avoid;
  }
  .print .strong {
    font-weight: 700;
  }
  .print .small {
    font-size: 11px;
    color: var(--text-2);
  }
  .print .tl > li,
  .print .lines > li {
    display: grid;
    grid-template-columns: 30mm minmax(0, 1fr);
    gap: var(--sp-3);
    padding-block: var(--sp-1);
    break-inside: avoid;
  }
  .print .lines > li {
    border-bottom: 1px solid var(--line);
  }
  .print .lines .role {
    color: var(--text-2);
  }
  .print .bullets {
    display: grid;
    gap: var(--sp-1);
    font-size: 11px;
    color: var(--text-2);
  }
  .print .stack {
    display: grid;
    gap: var(--sp-2);
  }
  .print .skills {
    display: grid;
    gap: var(--sp-1);
  }
  /* 외부 기여 표: 한 항목이 한 줄이다. 긴 제목은 잘리고, 다른 개발자의 수정 PR과 사유는 아래 줄에 붙는다. */
  .print .ctable {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 10.5px;
    line-height: 1.35;
  }
  .print .ctable th {
    padding: 0 var(--sp-2) var(--sp-1) 0;
    font-family: var(--font-mono);
    font-weight: 400;
    text-align: left;
    color: var(--text-3);
    border-bottom: 1px solid var(--line-strong);
  }
  .print .ctable td {
    padding: 1px var(--sp-2) 1px 0;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  .print .ctable tr {
    break-inside: avoid;
  }
  .print .ctable th:nth-child(1) {
    width: 17mm;
  }
  .print .ctable th:nth-child(2) {
    width: 27mm;
  }
  .print .ctable th:nth-child(3) {
    width: 33mm;
  }
  .print .ctable .ref {
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .print .ctable__title {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .print .ctable__sub {
    display: block;
    color: var(--text-3);
  }
  .print .asof {
    margin-top: var(--sp-1);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-3);
  }
  .print .footnote {
    margin-top: var(--sp-4);
    font-size: 10.5px;
    color: var(--text-3);
  }
</style>
