---
import 'pretendard/dist/web/static/pretendard-dynamic-subset.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="print">
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 12mm;
  }
  body.print {
    background: var(--surface);
    font-size: 11.5px;
    line-height: 1.5;
  }
  .print main {
    max-width: 178mm;
    margin-inline: auto;
  }
  .print .page {
    break-after: page;
  }
  .print .page:last-child {
    break-after: auto;
  }
  .print h1 {
    font-size: 22px;
    font-weight: 800;
  }
  .print .headline {
    display: block;
    font-size: 16px;
    font-weight: 700;
    margin-top: var(--sp-1);
  }
  .print h2 {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--text-3);
    margin: var(--sp-4) 0 var(--sp-2);
    padding-bottom: var(--sp-1);
    border-bottom: 1px solid var(--line);
  }
  .print .page > h2:first-child {
    margin-top: 0;
  }
  .print .kicker,
  .print .when {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-3);
  }
  .print .lead {
    color: var(--text-2);
    margin-top: var(--sp-1);
  }
  .print .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .print .grid2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-2);
  }
  .print .box {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-2) var(--sp-3);
    break-inside: avoid;
  }
  .print .strong {
    font-weight: 700;
  }
  .print .small {
    font-size: 11px;
    color: var(--text-2);
  }
  .print .tl > li,
  .print .lines > li {
    display: grid;
    grid-template-columns: 30mm minmax(0, 1fr);
    gap: var(--sp-3);
    padding-block: var(--sp-1);
    break-inside: avoid;
  }
  .print .lines > li {
    border-bottom: 1px solid var(--line);
  }
  .print .lines .role {
    color: var(--text-2);
  }
  .print .bullets {
    display: grid;
    gap: var(--sp-1);
    font-size: 11px;
    color: var(--text-2);
  }
  .print .stack {
    display: grid;
    gap: var(--sp-3);
  }
  .print .skills {
    display: grid;
    gap: var(--sp-1);
  }
  .print .contribs > li {
    display: grid;
    grid-template-columns: 24mm 32mm minmax(0, 1fr);
    gap: 0 var(--sp-2);
    align-items: baseline;
  }
  .print .contribs .small {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .print .contribs .note {
    grid-column: 3;
    white-space: normal;
    overflow: visible;
  }
  .print .footnote {
    margin-top: var(--sp-4);
    font-size: 10.5px;
    color: var(--text-3);
  }
</style>
