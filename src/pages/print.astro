---
import Evidence from '../components/Evidence.astro';
import ProjectBrief from '../components/ProjectBrief.astro';
import Status from '../components/Status.astro';
import Print from '../layouts/Print.astro';
import { engagementSummary, engagementTally, printRows, shortRepo, sortEngagements } from '../lib/contribution-stats';
import { formatDate, formatPeriod, shortRef } from '../lib/format';
import { liveMetrics } from '../lib/live-metrics';
import { projectHref } from '../lib/links';
import { loadSite } from '../lib/site';
import { contributionStatus, relatedStatus, view } from '../lib/status';
import { buildTimeline } from '../lib/timeline';

const site = await loadSite();
const { profile } = site;
const timeline = buildTimeline(profile);
const strip = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const more = [...site.cards, ...site.lines];
// 외부 기여 표: 16줄까지만 싣되 저장소마다 한 줄 이상. 저장소 묶음 순서(병합 많은 순)대로, 묶음 안에서는 병합·승인·리뷰 중 순으로 둔다(홈의 보드와 같은 순서).
const { rows: contribRows, rest: contribRest } = printRows(site.contributions.items);
// 다른 개발자의 PR·이슈에 남긴 리뷰·댓글은 4쪽 안에 들도록 표 아래 한 줄로만 요약한다(목록은 사이트에 있다).
const engaged = site.contributions.engagements;
const engagedRepos = [...new Set(sortEngagements(engaged).map((e) => shortRepo(e.repo)))];
// 직접 운영하는 오픈소스 요약: 기여 데이터에서 계산한 수치가 있으면 핵심 결과와 그 수치를 함께(half), 없으면 핵심 결과만(quarter) 싣는다.
const ossSize = (id: string) => (liveMetrics(id, site.contributions).length > 0 ? 'half' : 'quarter');
const evidenceNote = profile.contact.site
  ? `프로젝트 핵심 수치의 근거는 웹 포트폴리오(${strip(profile.contact.site)})에서 확인할 수 있습니다.`
  : '프로젝트 핵심 수치의 근거는 웹 포트폴리오에서 확인할 수 있습니다.';
---
<Print title={`${profile.name} 포트폴리오`}>
  <section class="page">
    <header>
      <p class="kicker">{profile.nameEn}</p>
      <h1>
        {profile.name}{' '}
        <span class="headline"><span class="mark">{profile.headline.mark}</span> {profile.headline.rest}</span>
      </h1>
      {profile.intro.map((t) => <p class="lead">{t}</p>)}
      <ul class="contact">
        {profile.contact.email && <li><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></li>}
        <li><a href={profile.contact.github}>{strip(profile.contact.github)}</a></li>
        {profile.contact.site && <li><a href={profile.contact.site}>{strip(profile.contact.site)}</a></li>}
        <li data-private-slot="phone" hidden></li>
      </ul>
    </header>

    <h2>핵심 성과 · {formatDate(site.contributions.asOf)} 기준</h2>
    <ul class="grid2">
      {
        profile.highlights.map((h) => (
          <li class="box">
            <Status view={view(h.status, h.statusText)} />
            <p class="strong">{h.label}</p>
            <p class="small">{h.detail}</p>
            <Evidence evidence={h.evidence} />
          </li>
        ))
      }
    </ul>

    <h2>경력 · 활동</h2>
    <ol class="tl">
      {
        timeline.map((t) => (
          <li>
            <span class="when">{t.when}</span>
            <div>
              <p class="strong">{t.title}</p>
              {t.subtitle && <p class="small">{t.subtitle}</p>}
              {t.bullets.length > 0 && (
                <ul class="bullets">
                  {t.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <h2>일하는 방식</h2>
    <ul class="bullets">
      {profile.howIWork.principles.map((p) => <li><span class="strong">{p.title}</span> — {p.body}</li>)}
    </ul>

    <h2>오픈소스 · 외부 프로젝트 기여</h2>
    <table class="ctable">
      <thead>
        <tr>
          <th>저장소</th>
          <th>항목</th>
          <th>상태</th>
          <th>제목</th>
        </tr>
      </thead>
      <tbody>
        {
          contribRows.map((c) => (
            <tr>
              <td>{shortRepo(c.repo)}</td>
              <td class="ref"><a href={c.url}>{c.kind === 'pr' ? 'PR' : '이슈'} #{c.number}</a></td>
              <td><Status view={contributionStatus({ ...c, note: undefined })} /></td>
              <td>
                <span class="ctable__title">{c.title}</span>
                {(c.note || c.related.length > 0) && (
                  <span class="ctable__sub">
                    {c.note && <>— {c.note}</>}
                    {c.related.map((r, i) => (
                      <>{i > 0 && ' · '}다른 개발자 수정 PR <a href={r.url}>#{r.number}</a> ({relatedStatus(r).text})</>
                    ))}
                  </span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    {contribRest > 0 && <p class="rest">외 {contribRest}건 · 전체 목록은 사이트의 외부 기여 목록</p>}
    {
      engaged.length > 0 && (
        <p class="engage">
          다른 개발자의 작업 참여: {engagementSummary(engagementTally(engaged))} ({engagedRepos.join(', ')})
        </p>
      )
    }
    <p class="asof">매일 자동 확인 · 마지막 변경 {formatDate(site.contributions.asOf)}</p>

    <h2>오픈소스 · 직접 운영하는 프로젝트</h2>
    <div class="stack">{site.oss.map((p) => <ProjectBrief project={p} size={ossSize(p.id)} />)}</div>

    <h2>개인 프로젝트</h2>
    <div class="stack">{site.personal.map((p) => <ProjectBrief project={p} size="quarter" />)}</div>

    <h2>그 밖의 프로젝트</h2>
    <ul class="lines">
      {
        more.map((p) => {
          const target = projectHref(p);
          return (
            <li>
              <span class="when">{formatPeriod(p.data.period)}</span>
              <span>
                <span class="strong">{p.data.title}</span> — {p.data.tagline}
                <span class="role">{' · '}{p.data.role}</span>
                {target && target.external && (
                  <>
                    {' · '}
                    <a href={target.href}>{shortRef(target.href)}</a>
                  </>
                )}
              </span>
            </li>
          );
        })
      }
    </ul>

    <h2>기술 스택</h2>
    <ul class="skills">
      {profile.skills.map((g) => <li><span class="strong">{g.group}</span> — {g.items.map((i) => i.name).join(', ')}</li>)}
    </ul>

    <p class="footnote">
      {evidenceNote} AI 코딩 에이전트와의 협업 여부는 프로젝트마다 역할 표기에 밝혀 두었습니다.
    </p>
  </section>
</Print>
