---
import { byRepo, shortRepo, sortByPriority, tally } from '../../lib/contribution-stats';
import { formatDate } from '../../lib/format';
import type { Contributions } from '../../lib/schema';
import type { ProjectEntry } from '../../lib/site';
import { contributionStatus, relatedStatus } from '../../lib/status';
import Status from '../Status.astro';

interface Props {
  contributions: Contributions;
  byId: Map<string, ProjectEntry>;
}

const { contributions, byId } = Astro.props;
const total = tally(contributions.items);
const groups = byRepo(contributions.items);
const summary = [
  { label: '병합', value: total.merged },
  { label: '리뷰 중', value: total.inReview },
  { label: '이슈', value: total.issues },
  { label: '프로젝트', value: total.repos },
];
const headingId = (repo: string) => `cboard-${repo.replace('/', '--').toLowerCase()}`;
---
<div class="cboard" data-scene="contrib">
  <h3 class="cboard__title" data-reveal>외부 프로젝트 기여</h3>
  <dl class="cboard__sum" data-reveal>
    {
      summary.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd data-tally>{s.value}</dd>
        </div>
      ))
    }
  </dl>
  <div class:list={['cboard__repos', groups.length >= 3 && 'cboard__repos--cols']}>
    {
      groups.map((g) => (
        <section class="cboard__repo panel" data-repo={g.repo} aria-labelledby={headingId(g.repo)}>
          <header class="cboard__repo-head" data-reveal>
            <h4 id={headingId(g.repo)}>
              <a href={`https://github.com/${g.repo}`} target="_blank" rel="noopener noreferrer">
                {shortRepo(g.repo)} · {g.repo} <span aria-hidden="true">↗</span>
              </a>
            </h4>
            <p class="cboard__counts mono">
              이슈 {g.tally.issues} · PR {g.tally.prs} · 병합 {g.tally.merged}
            </p>
            {g.tools.length > 0 && (
              <p class="cboard__tools">
                찾은 도구:{' '}
                {g.tools.map((id, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/projects/${id}/`}>{byId.get(id)?.data.title ?? id}</a>
                  </>
                ))}
              </p>
            )}
          </header>
          <ul class="cboard__items">
            {sortByPriority(g.items).map((c) => (
              <li class="cboard__item" data-reveal data-state={c.state}>
                <div class="cboard__head">
                  <span class="cboard__kind mono">{c.kind === 'pr' ? 'PR' : '이슈'}</span>
                  <Status view={contributionStatus(c)} />
                  <a class="cboard__ref mono" href={c.url} target="_blank" rel="noopener noreferrer">
                    #{c.number} <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <p class="cboard__text">{c.title}</p>
                {c.related.length > 0 && (
                  <ul class="cboard__related">
                    {c.related.map((r) => (
                      <li>
                        다른 개발자의 수정 PR{' '}
                        <a href={r.url} target="_blank" rel="noopener noreferrer">
                          {shortRepo(r.repo)}#{r.number} <span aria-hidden="true">↗</span>
                        </a>{' '}
                        <Status view={relatedStatus(r)} />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="cboard__asof mono" data-reveal>매일 자동 확인 · 마지막 변경 {formatDate(contributions.asOf)}</p>
</div>

<style>
  .cboard {
    display: grid;
    gap: var(--sp-8);
    padding-block: var(--sp-8) var(--sp-12);
  }
  .cboard__title {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  /* 요약: 큰 숫자 네 칸. 읽는 순서는 이름 다음 숫자지만 눈에는 숫자가 위에 온다. */
  .cboard__sum {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6);
  }
  .cboard__sum > div {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 2px solid var(--text);
  }
  .cboard__sum dt {
    order: 2;
    font-weight: 700;
  }
  .cboard__sum dd {
    order: 1;
    font-size: var(--fs-figure);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .cboard__repos {
    display: grid;
    gap: var(--sp-4);
  }
  .cboard__repo {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
  }
  .cboard__repo-head {
    display: grid;
    gap: var(--sp-1);
  }
  .cboard__repo h4 {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.4;
  }
  .cboard__repo h4 a {
    color: var(--text);
  }
  .cboard__counts {
    font-size: var(--fs-mono);
    color: var(--text-3);
  }
  .cboard__tools {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__items {
    display: grid;
    gap: var(--sp-2);
  }
  .cboard__item {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }
  .cboard__item[data-state='merged'] {
    border-color: var(--ok-line);
  }
  /* 상태 칩은 flex 항목이라 변형(도장 찍기)이 먹는다. */
  .cboard__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-3);
  }
  /* 닫힌 PR의 상태 글자는 사유가 붙어 길 수 있다. 좁은 화면에서 넘치지 않게 줄바꿈을 허용한다. */
  .cboard__head :global(.status) {
    white-space: normal;
  }
  .cboard__kind {
    font-size: var(--fs-mono);
    color: var(--text-3);
  }
  .cboard__ref {
    font-size: var(--fs-mono);
  }
  .cboard__text {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__related {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__asof {
    font-size: var(--fs-mono);
    color: var(--text-3);
  }
  /* 묶음마다 길이가 크게 달라 행을 맞추면 짧은 묶음 옆이 비므로, 3개 이상일 때는 두 단으로 흘린다. */
  @media (min-width: 1024px) {
    .cboard__repos--cols {
      display: block;
      column-count: 2;
      column-gap: var(--sp-4);
    }
    .cboard__repos--cols > .cboard__repo {
      break-inside: avoid;
      margin-bottom: var(--sp-4);
    }
  }
  @media (max-width: 767px) {
    .cboard__sum {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-4);
    }
  }
</style>
