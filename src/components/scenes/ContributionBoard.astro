---
import {
  byRepo,
  engagementSummary,
  engagementTally,
  shortRepo,
  sortByPriority,
  tally,
  visibleEngagements,
} from '../../lib/contribution-stats';
import { formatDate } from '../../lib/format';
import type { Contribution, Contributions, Engagement } from '../../lib/schema';
import type { ProjectEntry } from '../../lib/site';
import { contributionStatus, engagementStatus, engagementTarget, relatedStatus } from '../../lib/status';
import Status from '../Status.astro';

interface Props {
  contributions: Contributions;
  byId: Map<string, ProjectEntry>;
}

const { contributions, byId } = Astro.props;
const total = tally(contributions.items);
const groups = byRepo(contributions.items);
const summary = [
  { label: '병합', value: total.merged },
  { label: '열린 PR', value: total.openPrs },
  { label: '이슈', value: total.issues },
  { label: '프로젝트', value: total.repos },
];
const headingId = (repo: string) => `cboard-${repo.replace('/', '--').toLowerCase()}`;
const kindLabel = (c: Pick<Contribution, 'kind'>) => (c.kind === 'pr' ? 'PR' : '이슈');

// 다른 개발자의 PR·이슈에 남긴 리뷰와 댓글. 직접 연 기여(위 묶음과 요약 숫자)와 섞지 않는다.
const engaged = visibleEngagements(contributions.engagements);
const engagedSummary = engagementSummary(engagementTally(contributions.engagements));
const engagedLabel = (e: Engagement) => `${shortRepo(e.repo)} ${kindLabel(e)}`;
const { author, excludeOwners } = contributions;
const engagedScope = [
  `involves:${author}`,
  `-author:${author}`,
  `-user:${author}`,
  ...excludeOwners.filter((o) => o.toLowerCase() !== author.toLowerCase()).map((o) => `-org:${o}`),
];
const engagedSearch = `https://github.com/search?q=${encodeURIComponent(engagedScope.join(' '))}&type=issues`;
---
<div class="cboard" data-scene="contrib">
  <h3 class="cboard__title" data-reveal>외부 프로젝트 기여</h3>
  <dl class="cboard__sum" data-reveal>
    {
      summary.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd data-tally>{s.value}</dd>
        </div>
      ))
    }
  </dl>
  <div class:list={['cboard__repos', groups.length >= 3 && 'cboard__repos--cols']}>
    {
      groups.map((g) => (
        <section class="cboard__repo panel" data-repo={g.repo} aria-labelledby={headingId(g.repo)}>
          <header class="cboard__repo-head" data-reveal>
            <h4 id={headingId(g.repo)}>
              <a href={`https://github.com/${g.repo}`} target="_blank" rel="noopener noreferrer">
                {shortRepo(g.repo)} · {g.repo} <span aria-hidden="true">↗</span>
              </a>
            </h4>
            <p class="cboard__counts mono">
              이슈 {g.tally.issues} · PR {g.tally.prs} · 병합 {g.tally.merged}
            </p>
            {g.tools.length > 0 && (
              <p class="cboard__tools">
                찾은 도구:{' '}
                {g.tools.map((id, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/projects/${id}/`}>{byId.get(id)?.data.title ?? id}</a>
                  </>
                ))}
              </p>
            )}
          </header>
          <ul class="cboard__items">
            {sortByPriority(g.items).map((c) => (
              <li class="cboard__item" data-reveal data-state={c.state}>
                <div class="cboard__head">
                  <span class="cboard__kind mono">{kindLabel(c)}</span>
                  <Status view={contributionStatus(c)} />
                  <a class="cboard__ref mono" href={c.url} target="_blank" rel="noopener noreferrer">
                    <span class="sr-only">{kindLabel(c)}{' '}</span>#{c.number} <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <p class="cboard__text">{c.title}</p>
                {c.related.length > 0 && (
                  <ul class="cboard__related">
                    {c.related.map((r) => (
                      <li>
                        다른 개발자의 수정 PR{' '}
                        <a href={r.url} target="_blank" rel="noopener noreferrer">
                          {shortRepo(r.repo)}#{r.number} <span aria-hidden="true">↗</span>
                        </a>{' '}
                        <Status view={relatedStatus(r)} />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  {
    engaged.shown.length > 0 && (
      <section class="cboard__eng panel" aria-labelledby="cboard-eng">
        <header class="cboard__eng-head" data-reveal>
          <h4 id="cboard-eng">다른 개발자의 작업에 참여</h4>
          <p class="cboard__eng-sum">{engagedSummary}</p>
        </header>
        <ul class="cboard__eng-list">
          {engaged.shown.map((e) => (
            <li class="cboard__eng-item" data-reveal data-review={e.review ?? 'none'}>
              <div class="cboard__head">
                <span class="cboard__kind mono">{engagedLabel(e)}</span>
                <Status view={engagementStatus(e)} />
                <a class="cboard__ref mono" href={e.url} target="_blank" rel="noopener noreferrer">
                  <span class="sr-only">{engagedLabel(e)}{' '}</span>#{e.number} <span aria-hidden="true">↗</span>
                </a>
              </div>
              <p class="cboard__text">{e.title}</p>
              <p class="cboard__eng-meta">
                {engagementTarget(e)}
                {' · '}
                <a class="cboard__eng-link" href={e.link} target="_blank" rel="noopener noreferrer">
                  내 {e.review ? '리뷰' : '댓글'} 보기<span class="sr-only"> ({engagedLabel(e)} #{e.number})</span>{' '}
                  <span aria-hidden="true">↗</span>
                </a>
              </p>
            </li>
          ))}
        </ul>
        {engaged.rest > 0 && (
          <p class="cboard__eng-rest">
            외 {engaged.rest}건 ·{' '}
            <a href={engagedSearch} target="_blank" rel="noopener noreferrer">
              GitHub에서 모두 보기 <span aria-hidden="true">↗</span>
            </a>
          </p>
        )}
      </section>
    )
  }
  <p class="cboard__asof mono" data-reveal>매일 자동 확인 · 마지막 변경 {formatDate(contributions.asOf)}</p>
</div>

<style>
  .cboard {
    display: grid;
    gap: var(--sp-8);
    padding-block: var(--sp-8) var(--sp-12);
  }
  .cboard__title {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  /* 요약: 큰 숫자 네 칸. 읽는 순서는 이름 다음 숫자지만 눈에는 숫자가 위에 온다. */
  .cboard__sum {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6);
  }
  .cboard__sum > div {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 2px solid var(--text);
  }
  .cboard__sum dt {
    order: 2;
    font-weight: 700;
  }
  .cboard__sum dd {
    order: 1;
    font-size: var(--fs-figure);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .cboard__repos {
    display: grid;
    gap: var(--sp-4);
  }
  .cboard__repo {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
  }
  .cboard__repo-head {
    display: grid;
    gap: var(--sp-1);
  }
  .cboard__repo h4 {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.4;
  }
  .cboard__repo h4 a {
    color: var(--text);
  }
  .cboard__counts {
    font-size: var(--fs-mono);
    color: var(--text-3);
  }
  .cboard__tools {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__items {
    display: grid;
    gap: var(--sp-2);
  }
  .cboard__item {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }
  .cboard__item[data-state='merged'] {
    border-color: var(--ok-line);
  }
  /* 상태 칩은 flex 항목이라 변형(도장 찍기)이 먹는다. */
  .cboard__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-3);
  }
  /* 닫힌 PR의 상태 글자는 사유가 붙어 길 수 있다. 좁은 화면에서 넘치지 않게 줄바꿈을 허용한다. */
  .cboard__head :global(.status) {
    white-space: normal;
  }
  .cboard__kind {
    font-size: var(--fs-mono);
    color: var(--text-3);
  }
  .cboard__ref {
    font-size: var(--fs-mono);
  }
  .cboard__text {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__related {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__asof {
    font-size: var(--fs-mono);
    color: var(--text-3);
  }
  /* 다른 개발자의 작업에 남긴 리뷰·댓글. 직접 연 기여 묶음과 같은 카드 모양을 쓰되, 승인한 리뷰만 테두리로 구분한다. */
  .cboard__eng {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
  }
  .cboard__eng-head {
    display: grid;
    gap: var(--sp-1);
  }
  .cboard__eng h4 {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.4;
  }
  .cboard__eng-sum {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  .cboard__eng-list {
    display: grid;
    gap: var(--sp-2);
  }
  .cboard__eng-item {
    display: grid;
    align-content: start;
    gap: var(--sp-1);
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }
  .cboard__eng-item[data-review='approved'] {
    border-color: var(--ok-line);
  }
  .cboard__eng-meta,
  .cboard__eng-rest {
    font-size: var(--fs-small);
    color: var(--text-2);
  }
  @media (min-width: 1024px) {
    .cboard__eng-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* 묶음마다 길이가 크게 달라 행을 맞추면 짧은 묶음 옆이 비므로, 3개 이상일 때는 두 단으로 흘린다. */
  @media (min-width: 1024px) {
    .cboard__repos--cols {
      display: block;
      column-count: 2;
      column-gap: var(--sp-4);
    }
    .cboard__repos--cols > .cboard__repo {
      break-inside: avoid;
      margin-bottom: var(--sp-4);
    }
  }
  @media (max-width: 767px) {
    .cboard__sum {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-4);
    }
  }
</style>
