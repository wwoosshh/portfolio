---
import { shortRepo } from '../lib/contribution-stats';
import { formatDate } from '../lib/format';
import type { Contribution } from '../lib/schema';
import { contributionStatus, relatedStatus } from '../lib/status';
import Status from './Status.astro';

interface Props {
  items: Contribution[];
  asOf: Date;
}

const { items, asOf } = Astro.props;
---
<div class="contribs">
  <p class="contribs__asof">매일 자동 확인 · 마지막 변경 {formatDate(asOf)}</p>
  <ul>
    {
      items.map((c) => (
        <li class="contrib">
          <div class="contrib__head">
            <Status view={contributionStatus(c)} />
            <a class="contrib__ref" href={c.url} target="_blank" rel="noopener noreferrer">
              {c.repo.split('/')[1]}#{c.number} <span aria-hidden="true">↗</span>
            </a>
            <span class="contrib__kind">{c.kind === 'pr' ? 'PR' : '이슈'}</span>
          </div>
          <p class="contrib__title">{c.title}</p>
          {c.related.length > 0 && (
            <ul class="contrib__related">
              {c.related.map((r) => (
                <li>
                  다른 개발자의 수정 PR{' '}
                  <a href={r.url} target="_blank" rel="noopener noreferrer">
                    {shortRepo(r.repo)}#{r.number} <span aria-hidden="true">↗</span>
                  </a>{' '}
                  <Status view={relatedStatus(r)} />
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contribs__asof {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-3);
    margin-bottom: var(--sp-2);
  }
  .contrib {
    padding-block: var(--sp-2);
    border-bottom: 1px solid var(--line);
  }
  .contrib__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3);
  }
  .contrib__ref,
  .contrib__kind {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }
  .contrib__kind {
    color: var(--text-3);
  }
  .contrib__title {
    font-size: var(--fs-small);
    color: var(--text-2);
    margin-top: var(--sp-1);
  }
  .contrib__related {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    color: var(--text-2);
  }
</style>
